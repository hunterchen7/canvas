{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": "../..",
    "paths": {
      "@canvas-source": ["src/index.ts"]
    }
  },
  "include": ["fixture/**/*.ts", "fixture/**/*.tsx"]
}
